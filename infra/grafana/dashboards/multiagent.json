{
  "title": "Multi-Agent AI System",
  "uid": "multiagent",
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "title": "Runs per minute by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (status) (rate(pipeline_runs_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "title": "Validator pass rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(validator_verdicts_total{verdict=\"pass\"}[15m])) / clamp_min(sum(rate(validator_verdicts_total[15m])), 1)"
        }
      ]
    },
    {
      "title": "Run duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(pipeline_run_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(pipeline_run_duration_seconds_bucket[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Model tokens per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (direction) (rate(llm_tokens_total[5m]))", "legendFormat": "{{direction}}" }
      ]
    },
    {
      "title": "Estimated model cost (USD, total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [{ "expr": "sum(llm_cost_usd_total)" }]
    },
    {
      "title": "LLM retry rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(llm_retries_total[5m])) / clamp_min(sum(rate(llm_calls_total[5m])), 1)", "legendFormat": "retries / call" }
      ]
    },
    {
      "title": "HTTP request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
