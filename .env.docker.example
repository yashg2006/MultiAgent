# Copy to .env for `docker compose up`. At minimum set JWT_SECRET.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=change-me

# mock (free, offline) or anthropic (set ANTHROPIC_API_KEY).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
SEARCH_TOOL=wikipedia

# Published ports on the host.
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
# Set true when the stack is served over HTTPS.
COOKIE_SECURE=false
