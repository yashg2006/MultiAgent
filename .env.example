# Copy this file to .env and adjust as needed. Never commit .env.

ENV=development

# --- LLM -------------------------------------------------------------------
# "mock" runs fully offline with no key and no cost. "anthropic" uses Claude.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional alternative: LLM_PROVIDER=openai (also `pip install openai`).
OPENAI_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Transient provider errors are retried with exponential backoff; after
# CIRCUIT_FAILURE_THRESHOLD consecutive failures, calls fail fast for
# CIRCUIT_RESET_SECONDS.
LLM_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

# --- Pipeline --------------------------------------------------------------
# Research->Validate cycles before returning a partial result.
MAX_RETRIES=3
MAX_SUB_TASKS=3
MAX_PARALLEL_RESEARCH=4
# Minimum LLM-judge score (0-1) for the Validator to accept a result.
JUDGE_THRESHOLD=0.6
# "none" (no network) or "wikipedia" (free search used as research context).
SEARCH_TOOL=none

# --- Persistence and execution --------------------------------------------
# SQLite for local dev; Postgres e.g. postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./tasks.db
# Apply migrations when the API starts (set false when a separate step does it).
AUTO_MIGRATE=true
# "inline": run tasks inside the API process. "redis": arq workers run them
# (start with: arq src.worker.main.WorkerSettings).
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
WORKER_MAX_JOBS=4

# --- API and auth ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Session signing key. Required when ENV=production; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
TASK_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HEADERS=false
