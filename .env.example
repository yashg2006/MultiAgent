# Copy this file to .env and adjust as needed. Never commit .env.

ENV=development

# "mock" runs fully offline with no key. Set to "openai" (and `pip install openai`)
# to use a real model.
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Validation attempts before the orchestrator returns a partial result.
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.5

# API persistence and allowed browser origins (comma-separated).
DATABASE_URL=sqlite:///./tasks.db
CORS_ORIGINS=http://localhost:5173
